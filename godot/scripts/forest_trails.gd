static func distance_to_path(p: Vector2) -> float:
	var distance := 1000.0
	for segment in SEGMENTS:
		var nearest := Geometry2D.get_closest_point_to_segment(p, segment[0], segment[1])
		distance = minf(distance, p.distance_to(nearest))
	return distance


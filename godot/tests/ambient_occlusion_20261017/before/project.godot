; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Relic of the fallen star — Forêt des lueurs"
run/main_scene="res://experiments/arbres_20261014/playable_world.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[audio]

buses/default_bus_layout="uid://c1ceks23exolv"

[autoload]

AxeManager="*res://scripts/axe_manager.gd"
MCPRuntime="*res://addons/godot_mcp/runtime/mcp_runtime.gd"
AudioSettings="*res://scripts/audio_settings.gd"
CabinTravel="*res://scripts/cabin_travel.gd"
Inventory="*res://scripts/inventory.gd"
QuestManager="*res://scripts/quest_manager.gd"
DialogueManager="*res://scripts/dialogue_manager.gd"
SaveManager="*res://scripts/save_manager.gd"
MusicManager="*res://scripts/music_manager.gd"
PauseMenu="*res://scripts/pause_menu.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3.0
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

